{
  "$description": "ronson. brand v1. Mirrors tokens.css (Design Tokens / Style Dictionary shape).",
  "color": {
    "light": {
      "paper": { "$type": "color", "$value": "#f3f2ee" },
      "ink":   { "$type": "color", "$value": "#191917" },
      "quiet": { "$type": "color", "$value": "#6e6c66", "$description": "secondary text" },
      "line":  { "$type": "color", "$value": "#d6d4cd", "$description": "hairlines" },
      "cut":   { "$type": "color", "$value": "#ff4f00", "$description": "the dot; marks only" }
    },
    "dark": {
      "paper": { "$type": "color", "$value": "#121211" },
      "ink":   { "$type": "color", "$value": "#e9e7e1" },
      "quiet": { "$type": "color", "$value": "#8f8d86" },
      "line":  { "$type": "color", "$value": "#2c2b29" },
      "cut":   { "$type": "color", "$value": "#ff4f00" }
    }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Archivo", "Helvetica Neue", "Arial", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["Martian Mono", "ui-monospace", "Menlo", "monospace"] },
    "size": {
      "note":  { "$type": "dimension", "$value": "11px" },
      "body":  { "$type": "dimension", "$value": "16px" },
      "lead":  { "$type": "dimension", "$value": "20px" },
      "title": { "$type": "dimension", "$value": "28px" }
    },
    "leading": { "$value": 1.6 },
    "trackingNote": { "$value": "0.04em" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "8px" },
    "2": { "$type": "dimension", "$value": "16px" },
    "3": { "$type": "dimension", "$value": "32px" },
    "4": { "$type": "dimension", "$value": "64px" },
    "5": { "$type": "dimension", "$value": "128px" },
    "6": { "$type": "dimension", "$value": "192px" }
  },
  "line": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "tick":     { "$type": "dimension", "$value": "7px" }
  },
  "layout": {
    "measure": { "$type": "dimension", "$value": "36rem" },
    "gutter":  { "$type": "dimension", "$value": "24px" }
  }
}
